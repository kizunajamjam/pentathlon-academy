# 本番ビルドで Supabase が未設定だと、仮データを公開しないようビルドが失敗する。
# 確認用プレビュー（GitHub Pages）だけが NEXT_PUBLIC_IS_PREVIEW=1 でこれを避ける。

# Supabase
# 未設定でもサイトは表示できる（lib/db/seed.ts の仮データが使われる）。
# 設定するとお知らせ・スケジュール・イベントが DB 参照に切り替わり、
# 管理画面 (/admin) とお問い合わせフォームが有効になる。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# サーバー側でのみ使う。RLS を迂回するので絶対に NEXT_PUBLIC_ を付けないこと。
# 設定すると、お問い合わせをこのキーで保存する（匿名の insert 権限を閉じられる）。
# 手順は docs/SETUP.md の「お問い合わせの強化」。
SUPABASE_SERVICE_ROLE_KEY=

# お問い合わせの通知メール（任意）
# 3つすべて設定されているときだけ送信される。
# 未設定でも問い合わせは DB に保存され、管理画面から確認できる。
RESEND_API_KEY=
CONTACT_NOTIFY_TO=info@example.com
CONTACT_NOTIFY_FROM=no-reply@example.com

# 本番サイトの URL（sitemap.xml / robots.txt / OGP が参照する）
NEXT_PUBLIC_SITE_URL=https://example.com

# アクセス解析（任意）。Plausible に登録したドメインを入れると有効になる。
# Cookie を使わないので同意バナーは不要。確認用プレビューでは読み込まない。
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# お問い合わせの bot 対策（任意）。Cloudflare Turnstile のキー。両方入れると有効になる。
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
