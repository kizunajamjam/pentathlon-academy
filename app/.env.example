# Supabase
# 未設定でもサイトは表示できる（lib/db/seed.ts の仮データが使われる）。
# 設定するとお知らせ・スケジュール・イベントが DB 参照に切り替わり、
# 管理画面 (/admin) とお問い合わせフォームが有効になる。
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# サーバー側でのみ使う。RLS を迂回するので絶対に NEXT_PUBLIC_ を付けないこと。
# 現状のコードでは未使用（将来バッチ処理などで必要になった場合に使う）。
SUPABASE_SERVICE_ROLE_KEY=

# お問い合わせの通知メール（任意）
# 3つすべて設定されているときだけ送信される。
# 未設定でも問い合わせは DB に保存され、管理画面から確認できる。
RESEND_API_KEY=
CONTACT_NOTIFY_TO=info@example.com
CONTACT_NOTIFY_FROM=no-reply@example.com
